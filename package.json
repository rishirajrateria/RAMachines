{
  "name": "ramachine-website",
  "version": "1.0.0",
  "private": true,
  "description": "RA Machine — laser cutting machine manufacturer & exporter, Kolkata. Fully static Next.js site.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/content-audit.mjs",
    "start": "serve out -l 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "placeholders": "node scripts/generate-placeholders.mjs",
    "audit:content": "node scripts/content-audit.mjs"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@types/node": "22.15.3",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.21",
    "eslint": "9.32.0",
    "eslint-config-next": "15.5.25",
    "postcss": "8.5.6",
    "serve": "14.2.4",
    "sharp": "0.35.4",
    "tailwindcss": "3.4.19",
    "typescript": "5.8.3"
  },
  "engines": { "node": ">=20" }
}

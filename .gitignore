
# Next.js / build
# Ruflo local secrets and runtime data
# ruflo runtime state (keep agent definitions, ignore data/logs)
*.db-shm
*.db-wal
*.tsbuildinfo
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
.env
.env.*
.env.*.local
.env.local
.next/
.swarm/
next-env.d.ts
node_modules/
out/
ruvector.db

# ruflo runtime state
.claude-flow/daemon.pid
.claude-flow/daemon-state.json
.claude-flow/agents/
.claude-flow/metrics/
.claude-flow/memory-package.json
.claude-flow/harness-active-policy.json
.claude/checkpoints/
.claude-flow/policy/state.json
.claude-flow/swarm/swarm-state.json

# Scratch output from the illustration scripts
scripts/_debug.svg
scripts/_debug*.svg
scripts/_debug*.png

# Responsive image variants generated by scripts/optimize-images.mjs at build time.
# They all live under public/_img/, so one directory rule covers them and no filename
# pattern can accidentally match a real source (e.g. public/certs/iso-9001-2015.webp).
public/_img/

# Generated by scripts/optimize-images.mjs alongside the variants (212 KB, rebuilt every build).
lib/image-manifest.json
